---
import Base from '../layouts/Base.astro'
import Node from '../components/Node.astro'
import { cabecalho, ficheiros } from '../data'
import { t } from '../data/formato'

const idioma = 'pt' as const
const titulo = `404 — ${cabecalho.nome}`
const descricao = t(cabecalho.linhas[0]!, idioma)
/* O nome do documento traz o mês da revisão e muda com ela. Escrito à mão
   aqui, esta linha passava a apontar para um ficheiro que já não existe — e
   uma página de erro com um link partido é a pior das ironias. */
const cv = ficheiros.find((f) => f.id === 'cv-pt')!
---

<Base idioma={idioma} titulo={titulo} descricao={descricao} caminho="/404/" robots="noindex, follow">
  <main class="folha" id="conteudo">
    <header class="cabecalho cabecalho--simples">
      <div class="cabecalho__texto">
        <h1>404</h1>
        <p class="cabecalho__areas">não há nada neste caminho</p>
        <p>O que existe está listado em baixo.</p>
      </div>
    </header>
    <ul class="arvore" role="list">
      <Node nome="salgado.zip" href="/" colunas={[{ classe: 'nota', valor: 'a página, com tudo' }]} />
      <Node nome={cv.nome} href={cv.href} colunas={[{ classe: 'nota', valor: 'o percurso, em pdf' }]} />
      <Node nome="salgado.zip (ficheiro)" href="/salgado.zip" colunas={[{ classe: 'nota', valor: 'o mesmo, para descarregar' }]} />
    </ul>
  </main>
</Base>

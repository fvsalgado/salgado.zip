---
import Base from '../../layouts/Base.astro'
import Arquivo from '../../components/Arquivo.astro'
import { paginaArquivo } from '../../data/pagina'

const idioma = 'en' as const
const { titulo, descricao, caminho, alternos } = paginaArquivo(idioma)
---

<Base idioma={idioma} titulo={titulo} descricao={descricao} caminho={caminho} alternos={alternos}>
  <Arquivo idioma={idioma} />
</Base>

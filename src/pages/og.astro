---
import '../styles/base.css'
import '../styles/og.css'
import { cabecalho, projetos } from '../data'
import { t, estado } from '../data/formato'

const idioma = 'pt' as const
const visiveis = projetos.slice(0, 5)
---

<!doctype html>
<html lang="pt-PT" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <title>og</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <div class="og">
      <div>
        <div class="og__nome">{cabecalho.nome}</div>
        <div class="og__cargo">{t(cabecalho.cargo, idioma)}</div>
      </div>
      <div class="og__arvore">
        <div class="og__linha"><span>projetos/</span></div>
        {
          visiveis.map((p, i) => (
            <div class="og__linha">
              <span class="og__guia">{i === visiveis.length - 1 ? '└─' : '├─'}</span>
              <span>{p.dominio}</span>
              <span class="og__meta">{estado(p.estado, idioma)}</span>
            </div>
          ))
        }
      </div>
      <div class="og__pe">
        <span>salgado.zip</span>
        <span>{t(cabecalho.linhas[1]!, idioma)}</span>
      </div>
    </div>
  </body>
</html>

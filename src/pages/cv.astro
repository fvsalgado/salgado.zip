---
/**
 * Fonte do CV em PDF. Não está ligada de lado nenhum nem entra no sitemap:
 * o site público é um só, e esta rota existe para o scripts/artifacts.mjs
 * imprimir o dossiê em prosa.
 */
import Base from '../layouts/Base.astro'
import Dossier from '../components/Dossier.astro'
import { paginaDossie } from '../data/pagina.ts'

const idioma = 'pt' as const
const { titulo, descricao } = paginaDossie(idioma)
---

<Base idioma={idioma} titulo={titulo} descricao={descricao} caminho="/cv/" classe="dossie" robots="noindex, nofollow">
  <main class="folha" id="conteudo">
    <Dossier idioma={idioma} />
  </main>
</Base>

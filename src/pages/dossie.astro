---
import Base from '../layouts/Base.astro'
import ViewSwitch from '../components/ViewSwitch.astro'
import Controlos from '../components/Controlos.astro'
import Dossier from '../components/Dossier.astro'
import Rodape from '../components/Rodape.astro'
import { cabecalho } from '../data'
import { t } from '../data/formato'

const idioma = 'pt' as const
const titulo = `${cabecalho.nome} — ${t(cabecalho.cargo, idioma)}`
const descricao = `${cabecalho.nome}. ${t(cabecalho.linhas[0]!, idioma)}`
---

<Base idioma={idioma} titulo={titulo} descricao={descricao} caminho="/dossie/" classe="dossie">
  <main class="folha" id="conteudo">
    <div class="barra">
      <ViewSwitch idioma={idioma} atual="dossie" />
      <Controlos idioma={idioma} />
    </div>
    <Dossier idioma={idioma} />
    <Rodape idioma={idioma} />
  </main>
  <script>
    import '../scripts/arquivo'
  </script>
</Base>

---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Controlos from '../components/Controlos.astro'
import Archive from '../components/Archive.astro'
import Rodape from '../components/Rodape.astro'
import { cabecalho } from '../data'
import { t } from '../data/formato'

const idioma = 'pt' as const
const titulo = `${cabecalho.nome} — ${t(cabecalho.areas, idioma)}`
const descricao = `${cabecalho.nome}. ${t(cabecalho.linhas[0]!, idioma)}`
---

<Base idioma={idioma} titulo={titulo} descricao={descricao} caminho="/" alternos={{ pt: '/', en: '/en/' }}>
  <main class="folha" id="conteudo">
    <div class="barra">
      <span class="marca">
        salgado.zip
        <span aria-hidden="true"> · </span>
        <a href="/en/" hreflang="en">english</a>
      </span>
      <Controlos idioma={idioma} />
    </div>
    <Header idioma={idioma} />
    <Archive idioma={idioma} />
    <Rodape idioma={idioma} />
  </main>
  <script>
    import '../scripts/arquivo'
  </script>
</Base>

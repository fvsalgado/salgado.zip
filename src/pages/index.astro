---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import ViewSwitch from '../components/ViewSwitch.astro'
import Controlos from '../components/Controlos.astro'
import Archive from '../components/Archive.astro'
import Rodape from '../components/Rodape.astro'
import { cabecalho } from '../data'
import { t } from '../data/formato'

const idioma = 'pt' as const
const titulo = `${cabecalho.nome} — ${t(cabecalho.areas, idioma)}`
const descricao = `${cabecalho.nome}. ${t(cabecalho.linhas[0]!, idioma)}`
---

<Base idioma={idioma} titulo={titulo} descricao={descricao} caminho="/">
  <main class="folha" id="conteudo">
    <div class="barra">
      <ViewSwitch idioma={idioma} atual="arquivo" />
      <Controlos idioma={idioma} arvore={true} />
    </div>
    <Header idioma={idioma} />
    <Archive idioma={idioma} />
    <Rodape idioma={idioma} />
  </main>
  <script>
    import '../scripts/arquivo'
  </script>
</Base>

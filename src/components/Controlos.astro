---
/**
 * Camada JS progressiva. Nada disto é necessário para a página funcionar, por
 * isso os controlos nascem escondidos e só o script os revela.
 */
import type { Idioma } from '../data'

interface Props { idioma: Idioma }
const { idioma } = Astro.props
const rot =
  idioma === 'en'
    ? { abrir: 'expand all', fechar: 'collapse all', tema: 'Toggle theme' }
    : { abrir: 'abrir tudo', fechar: 'fechar tudo', tema: 'Alternar tema' }
---

<div class="controlos" data-controlos hidden>
  <button type="button" data-abrir-tudo aria-label={rot.abrir}>
    {idioma === 'en' ? 'expand' : 'abrir'}<span class="so-largo">{idioma === 'en' ? ' all' : ' tudo'}</span>
  </button>
  <span aria-hidden="true">·</span>
  <button type="button" data-fechar-tudo aria-label={rot.fechar}>
    {idioma === 'en' ? 'collapse' : 'fechar'}<span class="so-largo">{idioma === 'en' ? ' all' : ' tudo'}</span>
  </button>
  <span aria-hidden="true">·</span>
  <button type="button" class="tema" data-tema aria-label={rot.tema} title={rot.tema}>◐</button>
</div>

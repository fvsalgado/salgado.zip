---
/**
 * Parece um alternador, é dois links para rotas reais. Ganha-se: funciona sem
 * JS, é indexável, e o dossiê tem URL próprio para colar em candidaturas.
 */
import type { Idioma } from '../data'

interface Props { idioma: Idioma; atual: 'arquivo' | 'dossie' }
const { idioma, atual } = Astro.props

const rotas =
  idioma === 'en'
    ? { arquivo: '/en/', dossie: '/en/dossier/' }
    : { arquivo: '/', dossie: '/dossie/' }
const nomes =
  idioma === 'en' ? { arquivo: 'archive', dossie: 'dossier' } : { arquivo: 'arquivo', dossie: 'dossiê' }
---

<nav class="vista" aria-label={idioma === 'en' ? 'View' : 'Vista'}>
  <a href={rotas.arquivo} aria-current={atual === 'arquivo' ? 'page' : undefined}>{nomes.arquivo}</a>
  <a href={rotas.dossie} aria-current={atual === 'dossie' ? 'page' : undefined}>{nomes.dossie}</a>
</nav>

---
/**
 * O rodapé.
 *
 * Três linhas centradas e uma de coordenadas. A ordem é a da utilidade: quem
 * chega ao fim da página quer levar o CV, ou falar comigo, ou ver o código —
 * por essa ordem.
 *
 * Os dois CV têm linha só para eles, com um ícone à frente: partilhavam antes
 * a linha com a nota de privacidade, e o que se quer levar de um sítio destes
 * não pode ir a meio de uma frase sobre cookies.
 *
 * A linha das promessas diz três: o que não se faz a quem lê (sem cookies, sem
 * publicidade), o que se faz por quem lê (acessibilidade) e o que se dá a quem
 * quiser (código aberto, licença). Cada uma leva ao nó onde está escrita por
 * extenso — as duas primeiras apontaram ao mesmo enquanto a acessibilidade foi
 * um campo da privacidade, e deixaram de o fazer quando ganhou nó próprio.
 *
 * A hora de atualização saiu. Dizia a data do último commit de conteúdo, que é
 * informação sobre o repositório e não sobre quem lê — e o `lastmod` do
 * sitemap continua a dá-la a quem a usa mesmo, que são os motores de busca.
 *
 * Os ícones são desenho vetorial em linha, e não imagens: seguem a cor do
 * texto nos dois temas, não fazem um pedido, e não têm ficheiro para se
 * perder. Os três de contacto estão no IconeContacto.astro; a folha do CV fica
 * aqui, que é o único sítio onde aparece. As duas marcas aparecem para
 * identificar as plataformas onde tenho perfil, que é o uso para que existem.
 *
 * A linha dos contactos tem dois ramos porque tem dois tipos de ligação. O
 * `mailto:` abre o correio de quem lê e não uma janela — passá-lo pelo
 * Externo.astro fazia-o prometer uma janela nova que nunca abre, e por isso o
 * componente rebenta o build se lhe derem um. Os outros dois saem mesmo, e vão
 * por lá. Sem seta, nos dois casos: um logótipo do LinkedIn já diz para onde
 * vai, e uma seta ao lado de um ícone de dezasseis pixels lê-se como sujidade e
 * não como aviso. O aviso vai inteiro no nome acessível, onde faz falta.
 */
import { contacto, ficheiros } from '../data'
import type { Idioma } from '../data'
import { coordenadas } from '../data/formato'
import { codigoDoSite, perfilGithub, licenca } from '../data/textos.ts'
import Externo from './Externo.astro'
import IconeContacto from './IconeContacto.astro'

interface Props { idioma: Idioma }
const { idioma } = Astro.props

const ROTULOS: Record<
  Idioma,
  { sem: string; acesso: string; aberto: string; licenca: string }
> = {
  pt: { sem: 'sem cookies, sem publicidade', acesso: 'acessibilidade', aberto: 'código aberto', licenca: 'licença' },
  en: { sem: 'no cookies, no advertising', acesso: 'accessibility', aberto: 'open source', licenca: 'licence' },
  fr: { sem: 'sans cookies, sans publicité', acesso: 'accessibilité', aberto: 'code ouvert', licenca: 'licence' },
  es: { sem: 'sin cookies, sin publicidad', acesso: 'accesibilidad', aberto: 'código abierto', licenca: 'licencia' },
}
const rot = ROTULOS[idioma]

/**
 * Cada um rotulado na sua língua, seja qual for a da página: é a maneira mais
 * curta de dizer o que está lá dentro sem o traduzir. «CV in English» e não
 * «English CV» — o segundo lê-se como um CV feito à maneira inglesa, e o que
 * se está a dizer é a língua do documento, a par de «CV em português».
 */
const cvs = [
  { id: 'cv-pt', rotulo: 'CV em português' },
  { id: 'cv-en', rotulo: 'CV in English' },
]
  .map((d) => ({ ...d, href: ficheiros.find((f) => f.id === d.id)?.href ?? null }))
  .filter((d): d is { id: string; rotulo: string; href: string } => d.href !== null)

/** Os sítios onde se me encontra, e só os que estão confirmados. */
const contactos = [
  contacto.email ? { nome: 'email', href: `mailto:${contacto.email}`, icone: 'mail' as const } : null,
  contacto.linkedin ? { nome: 'LinkedIn', href: contacto.linkedin, icone: 'linkedin' as const } : null,
  { nome: 'GitHub', href: perfilGithub, icone: 'github' as const },
].filter((c): c is { nome: string; href: string; icone: 'mail' | 'linkedin' | 'github' } => c !== null)
---

<footer class="rodape">
  <p class="rodape__cv rodape__ecra">
    {cvs.map((c) => (
      <a class="rodape__doc" href={c.href}>
        {/* Uma folha com o canto dobrado: o desenho mais curto que diz «documento». */}
        <svg class="icone" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M4 1h5l3.5 3.5V15H4V1zm4.6 1.2v2.9h2.9L8.6 2.2zM5.2 2.2v11.6h6.1V6.3H7.4V2.2H5.2z"
          />
        </svg>
        {c.rotulo}
      </a>
    ))}
  </p>

  <p class="rodape__contactos rodape__ecra">
    {contactos.map((c) =>
      c.href.startsWith('mailto:') ? (
        <a href={c.href} aria-label={c.nome} title={c.nome}>
          <IconeContacto icone={c.icone} />
        </a>
      ) : (
        <Externo href={c.href} nome={c.nome} idioma={idioma} semSeta={true} titulo={c.nome}>
          <IconeContacto icone={c.icone} />
        </Externo>
      )
    )}
  </p>

  <p class="rodape__nota">
    <a href="#privacidade">{rot.sem}</a>
    <span aria-hidden="true"> · </span>
    <a href="#acessibilidade">{rot.acesso}</a>
    <span aria-hidden="true"> · </span>
    <Externo href={codigoDoSite} nome={rot.aberto} idioma={idioma} />
    <span aria-hidden="true"> · </span>
    <Externo href={licenca.url} nome={`${rot.licenca} ${licenca.nome}`} idioma={idioma} />
  </p>

  {contacto.lugares.length > 0 && (
    <p class="rodape__lugares">{coordenadas(contacto.lugares)}</p>
  )}
</footer>

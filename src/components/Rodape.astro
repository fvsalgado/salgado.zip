---
import { datas, contacto, ficheiros } from '../data'
import type { Idioma } from '../data'
import { dataCurta, coordenadas } from '../data/formato'

interface Props { idioma: Idioma }
const { idioma } = Astro.props

const ROTULOS: Record<Idioma, { atualizado: string; semRastreio: string }> = {
  pt: { atualizado: 'atualizado', semRastreio: 'sem cookies, sem rastreio' },
  en: { atualizado: 'updated', semRastreio: 'no cookies, no tracking' },
  fr: { atualizado: 'mis à jour', semRastreio: 'sans cookies, sans traçage' },
  es: { atualizado: 'actualizado', semRastreio: 'sin cookies, sin rastreo' },
}
const rot = ROTULOS[idioma]

const maisRecente = Object.values(datas).sort().at(-1)
const quando = dataCurta(maisRecente, idioma)

/**
 * Os dois documentos, e não o arquivo inteiro: quem chega ao fim da página é
 * quem quer levar alguma coisa, e o que se leva de um sítio destes é o CV. O
 * .zip continua em `ficheiros/`, com o tamanho ao lado.
 *
 * Os dois saem sempre, seja qual for a língua da interface — cada um rotulado
 * na sua, que é a maneira mais curta de dizer o que está lá dentro sem o
 * traduzir. Quem lê inglês reconhece «CV in English» numa página portuguesa, e
 * ao contrário também; quem lê a página em francês percebe pelo rótulo que os
 * documentos são dois e nenhum deles é em francês, que é a verdade.
 */
const cvs = [
  { id: 'cv-pt', rotulo: 'CV em português' },
  { id: 'cv-en', rotulo: 'CV in English' },
]
  .map((d) => ({ ...d, href: ficheiros.find((f) => f.id === d.id)?.href ?? null }))
  .filter((d): d is { id: string; rotulo: string; href: string } => d.href !== null)
---

<footer class="rodape">
  <span>
    salgado.zip{quando ? ` · ${rot.atualizado} ${quando}` : ''}
  </span>
  <span class="rodape__ecra">
    {cvs.map((c, i) => (
      <>
        {i > 0 && <span aria-hidden="true"> · </span>}
        <a href={c.href}>{c.rotulo}</a>
      </>
    ))}
    <span aria-hidden="true"> · </span>
    {rot.semRastreio}
  </span>
  {contacto.lugares.length > 0 && (
    <span class="rodape__lugares">{coordenadas(contacto.lugares)}</span>
  )}
</footer>

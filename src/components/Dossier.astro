---
/**
 * A segunda renderização. Mesmo conteúdo, mesma fonte, prosa corrida: sem
 * mono, sem árvore, sem metáfora.
 *
 * É o documento que sai em PDF — um por língua, com tudo lá dentro. Quem
 * recruta descarrega um ficheiro, não três, e o que abre está paginado,
 * numerado e pronto a imprimir.
 */
import { cabecalho, projetos, posicoes, mandatos, formacao, contacto } from '../data'
import { colofao } from '../data/textos.ts'
import type { Idioma } from '../data'
import { t, periodoLongo, estado } from '../data/formato'

interface Props { idioma: Idioma }
const { idioma } = Astro.props
const en = idioma === 'en'

const rot = en
  ? { percurso: 'Career', projetos: 'Projects', mandatos: 'Institutional mandates',
      formacao: 'Certificates', idiomas: 'Languages', colofao: 'Colophon', capturas: 'The projects, at a glance' }
  : { percurso: 'Percurso', projetos: 'Projetos', mandatos: 'Mandatos institucionais',
      formacao: 'Certificados', idiomas: 'Idiomas', colofao: 'Colofão', capturas: 'Os projetos, à vista' }

const comCaptura = projetos.filter((p) => p.shot !== null)
const curto = (u: string) => u.replace(/^https:\/\/(www\.)?/, '')
---

<article class="dossie__doc">
  <header class="dossie__cabeca">
    <div class="dossie__intro">
      <h1>{cabecalho.nome}</h1>
      <p class="cabecalho__areas">{t(cabecalho.areas, idioma)}</p>
      <div class="cabecalho cabecalho--dossie">
        {cabecalho.linhas.map((l) => <p>{t(l, idioma)}</p>)}
      </div>
    </div>
    <img
      class="retrato retrato--dossie"
      src="/fabio-salgado.jpg"
      alt={en ? `Portrait of ${cabecalho.nome}` : `Retrato de ${cabecalho.nome}`}
      width="200"
      height="200"
      decoding="async"
    />
  </header>

  <!-- Quem recruta procura o contacto na primeira página, não na última. -->
  <div class="tarja">
    <div class="tarja__campos">
      <p>
        {contacto.email && <a href={`mailto:${contacto.email}`}>{contacto.email}</a>}
        {contacto.linkedin && <a href={contacto.linkedin} rel="noopener">{curto(contacto.linkedin)}</a>}
        <a href="https://salgado.zip">salgado.zip</a>
      </p>
      <p class="tarja__onde">{t(contacto.concelho, idioma)} · {t(contacto.naturalidade, idioma)}</p>
    </div>
    <img class="tarja__qr" src="/qr.svg" alt={en ? 'QR code for salgado.zip' : 'Código QR para salgado.zip'} width="120" height="120" />
  </div>

  <section data-seccao="projetos">
    <h2>{rot.projetos}</h2>
    {
      projetos.map((p) => (
        <div class="entrada" id={`d-${p.id}`}>
          <div class="entrada__cabeca">
            <h3>{p.url !== null ? <a href={p.url} rel="noopener">{p.dominio}</a> : p.dominio}</h3>
            <span class="entrada__quando">
              {p.periodo ? periodoLongo(p.periodo, idioma) : ''}
              {/* «em curso · ativo» dizia duas vezes a mesma coisa: só o privado acrescenta. */}
              {p.estado === 'privado' ? `${p.periodo ? ' · ' : ''}${estado(p.estado, idioma)}` : ''}
            </span>
          </div>
          <p class="entrada__onde">{t(p.papel, idioma)}</p>
          <div class="entrada__corpo">
            <p>{t(p.linha, idioma)}</p>
            {p.detalhe.map((d) => <p>{t(d, idioma)}</p>)}
          </div>
        </div>
      ))
    }
  </section>

  {
    comCaptura.length > 0 && (
      <section data-seccao="capturas">
        <h2>{rot.capturas}</h2>
        <div class="capturas">
          {comCaptura.map((p) => (
            <figure class="captura">
              <img src={`/shots/${p.shot}`} alt={`${en ? 'Screenshot of' : 'Captura de ecrã de'} ${p.dominio}`} decoding="async" />
              <figcaption>{p.dominio}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  {
    posicoes.length > 0 && (
      <section data-seccao="percurso">
        <h2>{rot.percurso}</h2>
        {posicoes.map((p) => (
          <div class="entrada" id={`d-${p.id}`}>
            <div class="entrada__cabeca">
              <h3>{t(p.cargo, idioma)}</h3>
              <span class="entrada__quando">{periodoLongo(p.periodo, idioma)}</span>
            </div>
            <p class="entrada__onde">{p.organizacao}</p>
            <div class="entrada__corpo">
              {p.linhas.map((l) => <p>{t(l, idioma)}</p>)}
            </div>
          </div>
        ))}
      </section>
    )
  }

  {
    mandatos.length > 0 && (
      <section data-seccao="mandatos">
        <h2>{rot.mandatos}</h2>
        {mandatos.map((m) => (
          <div class:list={['entrada', m.linhas.length === 0 && 'entrada--linha']} id={`d-${m.id}`}>
            <div class="entrada__cabeca">
              <h3>{t(m.cargo, idioma)}</h3>
              <span class="entrada__quando">{periodoLongo(m.periodo, idioma)}</span>
            </div>
            <p class="entrada__onde">{m.organizacao}</p>
            {m.linhas.length > 0 && (
              <div class="entrada__corpo">
                {m.linhas.map((l) => <p>{t(l, idioma)}</p>)}
              </div>
            )}
          </div>
        ))}
      </section>
    )
  }

  {
    formacao.length > 0 && (
      <section data-seccao="formacao">
        <h2>{rot.formacao}</h2>
        {formacao.map((f) => (
          <div class="entrada entrada--linha" id={`d-${f.id}`}>
            <div class="entrada__cabeca">
              <h3>{t(f.curso, idioma)}</h3>
              <span class="entrada__quando">{periodoLongo(f.periodo, idioma)}</span>
            </div>
            <p class="entrada__onde">{f.instituicao}</p>
          </div>
        ))}
        <p class="nota">
          {en
            ? 'Online courses, taken independently. Not degrees from these institutions.'
            : 'Cursos online, feitos por conta própria. Não são graus destas instituições.'}
        </p>
      </section>
    )
  }

  {
    contacto.idiomas.length > 0 && (
      <section data-seccao="idiomas">
        <h2>{rot.idiomas}</h2>
        <p>{contacto.idiomas.map((i) => `${t(i.lingua, idioma)} (${t(i.nivel, idioma)})`).join(' · ')}</p>
      </section>
    )
  }

  <section data-seccao="colofao">
    <h2>{rot.colofao}</h2>
    {colofao.map((l) => <p>{t(l, idioma)}</p>)}
  </section>

</article>

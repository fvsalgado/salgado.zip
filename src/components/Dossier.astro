---
/**
 * A segunda renderização. Mesmo conteúdo, mesma fonte, prosa corrida: sem
 * mono, sem árvore, sem metáfora.
 *
 * É o documento que sai em PDF — um por língua, com tudo lá dentro. Quem
 * recruta descarrega um ficheiro, não três, e o que abre está paginado,
 * numerado e pronto a imprimir.
 *
 * Só em português e em inglês. A página existe em quatro línguas; os
 * documentos, não — e o tipo diz isso em vez de o deixar ao cuidado de quem
 * criar a próxima rota. Um PDF em francês passa a existir no dia em que
 * alguém o peça, e nesse dia é este tipo que se alarga.
 */
import { cabecalho, projetos, leituras, posicoes, mandatos, formacao, contacto, medidasVoz, RUBRICA, CANONICO } from '../data'
import { colofaoDocumento, notaCertificados } from '../data/textos.ts'
import type { Idioma } from '../data'
import { t, periodoLongo, estado } from '../data/formato'
import Externo from './Externo.astro'

interface Props { idioma: Extract<Idioma, 'pt' | 'en'> }
const { idioma } = Astro.props
const en = idioma === 'en'

const rot = en
  ? { percurso: 'Career', projetos: 'Projects', mandatos: 'Elected office',
      formacao: 'Certificates', idiomas: 'Languages', colofao: 'Colophon', capturas: 'The projects, at a glance',
      voz: 'Voice' }
  : { percurso: 'Percurso', projetos: 'Projetos', mandatos: 'Mandatos institucionais',
      formacao: 'Certificados', idiomas: 'Idiomas', colofao: 'Colofão', capturas: 'Os projetos, à vista',
      voz: 'Voz' }

/**
 * As leituras, no papel, são um parágrafo e não nove entradas. No ecrã a
 * árvore aguenta uma lista; num CV de duas páginas, nove linhas de uma rubrica
 * de podcast desequilibravam o percurso. O que o parágrafo diz — quantas,
 * quando, quanto tempo, de quem são os textos — sai todo dos dados.
 */
const lidas = leituras.filter((l) => l.formato === 'audio')
const vistos = leituras.filter((l) => l.formato === 'video')
const palcos = leituras.filter((l) => l.formato === 'presencial')
/* Separadas por quem assina a peça. Numa só frase davam «sobre a obra de
   Alberto Pimenta, Fábio Salgado», que põe o meu nome na lista dos autores que
   fui ler — e chama leitura a uma noite que foi peça montada. */
const palcosAlheios = palcos.filter((l) => l.autoria !== cabecalho.nome)
const palcosMeus = palcos.filter((l) => l.autoria === cabecalho.nome)
const ondeQuando = (ls: typeof leituras) =>
  ls.map((l) => `${l.rubrica ?? l.editor} (${l.data.slice(0, 4)})`).join(', ')
const anos = (ls: typeof leituras) => ls.map((l) => Number(l.data.slice(0, 4)))
const segundosVoz = lidas.reduce((s, l) => s + (medidasVoz[l.id]?.segundos ?? 0), 0)
const horasVoz = `${Math.floor(segundosVoz / 3600)}h${String(Math.round((segundosVoz % 3600) / 60)).padStart(2, '0')}`
const autoresVoz = [...new Set(lidas.map((l) => l.autoria))].join(', ')

/** Três frases porque são três coisas: as leituras de uma rubrica, a voz de
 *  dois vídeos de outra casa, e as leituras em palco. Uma contagem só juntava-as
 *  e mentia nas três — e calar a terceira, que é a que se fez diante de gente,
 *  seria a pior das três omissões. */
const linhaVoz = en
  ? `${lidas.length} readings for ${RUBRICA.nome}, the ${RUBRICA.editor} podcast, between ${Math.min(...anos(lidas))} and ${Math.max(...anos(lidas))} — ${horasVoz} of audio. Texts by ${autoresVoz}.`
  : `${lidas.length} leituras para o ${RUBRICA.nome}, o podcast do ${RUBRICA.editor}, entre ${Math.min(...anos(lidas))} e ${Math.max(...anos(lidas))} — ${horasVoz} de áudio. Textos de ${autoresVoz}.`
const linhaVideo = vistos.length
  ? en
    ? `Voice for ${vistos.length} promotional films for Transborda, the Almada performing arts festival, in ${anos(vistos).sort().join(' and ')}.`
    : `Voz de ${vistos.length} vídeos de promoção do Transborda, a mostra de artes performativas de Almada, em ${anos(vistos).sort().join(' e ')}.`
  : null
const linhaPalco = palcosAlheios.length
  ? en
    ? `${palcosAlheios.length} readings on stage — ${ondeQuando(palcosAlheios)} — on the work of ${[...new Set(palcosAlheios.map((l) => l.autoria))].join(', ')}.`
    : `${palcosAlheios.length} leituras em palco — ${ondeQuando(palcosAlheios)} — sobre a obra de ${[...new Set(palcosAlheios.map((l) => l.autoria))].join(', ')}.`
  : null
const linhaAutor = palcosMeus.length
  ? en
    ? `${palcosMeus.length} solo night${palcosMeus.length > 1 ? 's' : ''} of my own devising — ${ondeQuando(palcosMeus)}.`
    : `${palcosMeus.length} ${palcosMeus.length > 1 ? 'noites' : 'noite'} a solo, de alinhamento próprio — ${ondeQuando(palcosMeus)}.`
  : null
/* «Está tudo» e não «os ficheiros»: desde que há leituras em palco, nem tudo
   o que o nó guarda é ficheiro, e a frase apontava para onde ir. */
const linhaFicheiros = en
  ? `It is all at ${CANONICO.replace('https://', '')}, under voz/.`
  : `Está tudo em ${CANONICO.replace('https://', '')}, no nó voz/.`

/** O mesmo cargo derivado que a página mostra: quem tem o papel na mão também
 *  tem de saber o que ele faz hoje sem ir procurar à secção do percurso. */
const atualDossie = posicoes.find((p) => p.periodo.fim === null)

const comCaptura = projetos.filter((p) => p.shot !== null)
/**
 * As capas entram no documento, no fim da secção da voz.
 *
 * Estiveram de fora por uma razão que continua boa: um currículo com capas de
 * livros de outros lê-se como se os livros fossem do candidato. O que resolve
 * isso não é escondê-las — é a legenda, que traz o autor colado ao título. Com
 * «Torto Arado · Itamar Vieira Junior» por baixo da imagem, ninguém confunde
 * quem escreveu com quem leu.
 *
 * No fim da secção e não junto de cada frase: a prosa da voz é um bloco só, e
 * intercalar imagens partia-a em cinco pedaços numa página que já é apertada.
 */
const comCapa = leituras.filter((l) => l.capa !== null)

/**
 * O que se viu, e não só o que se leu.
 *
 * A secção da voz dizia, em prosa, que houve dois vídeos e três noites em
 * palco, e depois mostrava quatro capas de livros — ou seja, mostrava a parte
 * de que não há imagem e calava a parte de que há. Entram as provas visuais
 * que existem: o fotograma de cada vídeo, e a primeira imagem de cada leitura
 * em palco que trouxe alguma.
 *
 * PRIMEIRA e não todas, por regra e não por gosto: das noites com registo há
 * duas fotografias de uma e um cartaz de outra, e publicar tudo dava a uma
 * noite o dobro do espaço da outra por acidente de arquivo. Quem quiser as
 * restantes tem-nas no nó `voz/` da página, que é onde vivem ao tamanho a que
 * foram feitas.
 *
 * A legenda leva o crédito por baixo do título, e o crédito não traduz: é o
 * nome de quem fez a fotografia. Nos vídeos leva a casa que os encomendou.
 * As Quartas da Palavra ficam de fora deste bloco por não ter aparecido
 * cartaz nenhum — a prosa acima continua a contá-las, que é o que importa.
 */
const registosVoz = leituras.flatMap((l) => {
  if (l.formato === 'video') {
    return [{
      chave: l.id,
      src: `/voz/${l.id}.webp`,
      alt: en ? `A frame from the film ${l.titulo}` : `Fotograma do vídeo ${l.titulo}`,
      titulo: l.titulo,
      nota: l.editor,
    }]
  }
  if (l.formato === 'presencial' && l.imagens.length > 0) {
    const img = l.imagens[0]
    return [{
      chave: l.id,
      src: `/voz/${img.ficheiro}`,
      alt: t(img.alt, idioma),
      titulo: l.titulo,
      nota: img.credito,
    }]
  }
  return []
})
const curto = (u: string) => u.replace(/^https:\/\/(www\.)?/, '')
---

<article class="dossie__doc">
  <header class="dossie__cabeca">
    <img
      class="retrato retrato--dossie"
      src="/fabio-salgado.jpg"
      alt={en ? `Portrait of ${cabecalho.nome}` : `Retrato de ${cabecalho.nome}`}
      width="200"
      height="200"
      decoding="async"
    />
    <div class="dossie__intro">
      <h1>{cabecalho.nome}</h1>
      {atualDossie && (
        <p class="cabecalho__cargo">
          {`${t(atualDossie.cargo, idioma)} ${en ? 'at' : 'na'} ${atualDossie.organizacao}`}
        </p>
      )}
      <p class="cabecalho__areas">{t(cabecalho.areas, idioma)}</p>
      <div class="cabecalho cabecalho--dossie">
        {cabecalho.linhas.map((l) => <p>{t(l, idioma)}</p>)}
      </div>
    </div>
  </header>

  <!-- Quem recruta procura o contacto na primeira página, não na última. -->
  <div class="tarja">
    <div class="tarja__campos">
      <p>
        {contacto.email && <a href={`mailto:${contacto.email}`}>{contacto.email}</a>}
        {contacto.linkedin && (
          <Externo href={contacto.linkedin} nome={curto(contacto.linkedin)} idioma={idioma} />
        )}
        <a href={CANONICO}>salgado.zip</a>
      </p>
      <p class="tarja__onde">{t(contacto.concelho, idioma)} · {t(contacto.naturalidade, idioma)}</p>
    </div>
    <img class="tarja__qr" src="/qr.svg" alt={en ? 'QR code for salgado.zip' : 'Código QR para salgado.zip'} width="120" height="120" />
  </div>

  {
    posicoes.length > 0 && (
      <section data-seccao="percurso">
        <h2>{rot.percurso}</h2>
        {posicoes.map((p) => (
          <div class="entrada" id={`d-${p.id}`}>
            <div class="entrada__cabeca">
              <h3>{t(p.cargo, idioma)}</h3>
              <span class="entrada__quando">{periodoLongo(p.periodo, idioma)}</span>
            </div>
            <p class="entrada__onde">{p.organizacao}</p>
            <div class="entrada__corpo">
              {p.linhas.map((l) => <p>{t(l, idioma)}</p>)}
            </div>
          </div>
        ))}
      </section>
    )
  }

  <section data-seccao="projetos">
    <h2>{rot.projetos}</h2>
    {
      projetos.map((p) => (
        <div class="entrada" id={`d-${p.id}`}>
          <div class="entrada__cabeca">
            <h3>
              {p.url !== null ? <Externo href={p.url} nome={p.dominio} idioma={idioma} /> : p.dominio}
            </h3>
            <span class="entrada__quando">
              {p.periodo ? periodoLongo(p.periodo, idioma) : ''}
              {/* «em curso · ativo» dizia duas vezes a mesma coisa: só o privado acrescenta. */}
              {p.estado === 'privado' ? `${p.periodo ? ' · ' : ''}${estado(p.estado, idioma)}` : ''}
            </span>
          </div>
          <p class="entrada__onde">{t(p.papel, idioma)}</p>
          <div class="entrada__corpo">
            <p>{t(p.linha, idioma)}</p>
            {p.detalhe.map((d) => <p>{t(d, idioma)}</p>)}
          </div>
        </div>
      ))
    }
  </section>

  {
    comCaptura.length > 0 && (
      <section data-seccao="capturas">
        <h2>{rot.capturas}</h2>
        <div class="capturas">
          {comCaptura.map((p) => (
            <figure class="captura">
              <img src={`/shots/${p.shot}`} alt={`${en ? 'Screenshot of' : 'Captura de ecrã de'} ${p.dominio}`} decoding="async" />
              <figcaption>{p.dominio}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  {
    leituras.length > 0 && (
      <section data-seccao="voz">
        <h2>{rot.voz}</h2>
        <p>{linhaVoz}</p>
        {linhaVideo && <p>{linhaVideo}</p>}
        {linhaPalco && <p>{linhaPalco}</p>}
        {linhaAutor && <p>{linhaAutor}</p>}
        <p>{linhaFicheiros}</p>
        {registosVoz.length > 0 && (
          <div class="registos">
            {registosVoz.map((r) => (
              <figure class="registo-doc">
                <img src={r.src} alt={r.alt} decoding="async" />
                <figcaption>
                  <span class="registo-doc__titulo">{r.titulo}</span>
                  <span class="registo-doc__nota">{r.nota}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        )}
        {comCapa.length > 0 && (
          <div class="capas">
            {comCapa.map((l) => (
              <figure class="capa-doc">
                <img
                  src={`/capas/${l.capa!.ficheiro}`}
                  alt={`${en ? 'Cover of' : 'Capa de'} ${l.capa!.obra}, ${en ? 'by' : 'de'} ${l.autoria}`}
                  decoding="async"
                />
                {/* Obra e autor em linhas próprias: numa coluna de 30mm, «Torto
                    Arado · Itamar Vieira Junior» numa linha só partia-se em
                    quatro, e a legenda ficava mais alta do que a capa. */}
                <figcaption>
                  <span class="capa-doc__obra">{l.capa!.obra}</span>
                  <span class="capa-doc__autor">{l.autoria}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </section>
    )
  }


  {
    mandatos.length > 0 && (
      <section data-seccao="mandatos">
        <h2>{rot.mandatos}</h2>
        {mandatos.map((m) => (
          <div class:list={['entrada', m.linhas.length === 0 && 'entrada--linha']} id={`d-${m.id}`}>
            <div class="entrada__cabeca">
              <h3>{t(m.cargo, idioma)}</h3>
              <span class="entrada__quando">{periodoLongo(m.periodo, idioma)}</span>
            </div>
            <p class="entrada__onde">{m.organizacao}</p>
            {m.linhas.length > 0 && (
              <div class="entrada__corpo">
                {m.linhas.map((l) => <p>{t(l, idioma)}</p>)}
              </div>
            )}
          </div>
        ))}
      </section>
    )
  }

  {
    formacao.length > 0 && (
      <section data-seccao="formacao">
        <h2>{rot.formacao}</h2>
        {formacao.map((f) => (
          <div class="entrada entrada--linha" id={`d-${f.id}`}>
            <div class="entrada__cabeca">
              {/* No papel a ligação não se vê — o print.css tira-lhe cor e
                  sublinhado —, mas o PDF guarda-a: quem abrir o documento no
                  ecrã carrega no nome do curso e cai na credencial. Um
                  currículo que se lê num leitor de PDF é o caso normal, e é
                  onde uma prova a um clique vale mais. */}
              <h3>
                {f.credencial === null ? (
                  t(f.curso, idioma)
                ) : (
                  <Externo href={f.credencial} nome={t(f.curso, idioma)} idioma={idioma} />
                )}
              </h3>
              <span class="entrada__quando">{periodoLongo(f.periodo, idioma)}</span>
            </div>
            <p class="entrada__onde">{f.instituicao}</p>
          </div>
        ))}
        <p class="nota">
          {t(notaCertificados, idioma)}
        </p>
      </section>
    )
  }

  {
    contacto.idiomas.length > 0 && (
      <section data-seccao="idiomas">
        <h2>{rot.idiomas}</h2>
        <p>{contacto.idiomas.map((i) => `${t(i.lingua, idioma)} (${t(i.nivel, idioma)})`).join(' · ')}</p>
      </section>
    )
  }

  <section data-seccao="colofao">
    <h2>{rot.colofao}</h2>
    {colofaoDocumento.map((l) => <p>{t(l, idioma)}</p>)}
  </section>

</article>

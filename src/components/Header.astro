---
import { cabecalho } from '../data'
import type { Idioma } from '../data'
import { t } from '../data/formato'

interface Props { idioma: Idioma }
const { idioma } = Astro.props

/** O texto alternativo do retrato: a única frase deste componente. */
const RETRATO: Record<Idioma, string> = {
  pt: `Retrato de ${cabecalho.nome}`,
  en: `Portrait of ${cabecalho.nome}`,
  fr: `Portrait de ${cabecalho.nome}`,
  es: `Retrato de ${cabecalho.nome}`,
}
---

<header class="cabecalho">
  <img
    class="retrato"
    src="/fabio-salgado.jpg"
    alt={RETRATO[idioma]}
    width="200"
    height="200"
    decoding="async"
  />
  <div class="cabecalho__texto">
    <h1>{cabecalho.nome}</h1>
    <p class="cabecalho__areas">{t(cabecalho.areas, idioma)}</p>
    {cabecalho.linhas.map((l) => <p>{t(l, idioma)}</p>)}
  </div>
</header>

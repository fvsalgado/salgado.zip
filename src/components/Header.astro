---
import { cabecalho } from '../data'
import type { Idioma } from '../data'
import { t } from '../data/formato'

interface Props { idioma: Idioma }
const { idioma } = Astro.props
const [primeira, ...resto] = cabecalho.linhas
---

<header class="cabecalho">
  <img
    class="retrato"
    src="/fabio-salgado.jpg"
    alt={idioma === 'en' ? `Portrait of ${cabecalho.nome}` : `Retrato de ${cabecalho.nome}`}
    width="200"
    height="200"
    decoding="async"
  />
  <div class="cabecalho__texto">
    <p>{cabecalho.nome}. {t(primeira!, idioma)}</p>
    {resto.map((l) => <p>{t(l, idioma)}</p>)}
  </div>
</header>

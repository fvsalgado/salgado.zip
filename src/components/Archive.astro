---
import Node from './Node.astro'
import { projetos, leituras, posicoes, mandatos, formacao, contacto, ficheiros, medidasVoz, RUBRICA, CANONICO } from '../data'
import { colofaoSite, codigoDoSite, licenca, notaCertificados } from '../data/textos.ts'
import { privacidade, notaPrivacidade } from '../data/privacidade.ts'
import type { Idioma } from '../data'
import { t, periodo, periodoLongo, tamanho, estado, duracao, duracaoLonga, dataCurta } from '../data/formato'

interface Props { idioma: Idioma }
const { idioma } = Astro.props

/**
 * Os rótulos da árvore vivem aqui e não em src/data porque são interface e não
 * conteúdo: quem abre a página vê-os, quem abre o PDF ou o resume.json não.
 *
 * Um bloco fechado por língua, e não um ternário por rótulo. Com duas línguas
 * o ternário ainda se lia; com quatro seria um rótulo por linha com quatro
 * ramos, e a garantia de que uma tradução ficava por fazer sem ninguém dar
 * por isso. Assim o tipo obriga: rótulo em falta é erro de build.
 */
interface Rotulos {
  /** Os nomes dos nós. A barra final é a metáfora da árvore, não decoração. */
  projetos: string
  voz: string
  percurso: string
  mandatos: string
  formacao: string
  contacto: string
  privacidade: string
  ficheiros: string
  colofao: string
  entradas: (n: number) => string
  /** Os totais da linha de cima. */
  contaProjetos: string
  contaLeituras: string
  contaCargos: string
  contaMandatos: string
  nascido: (ano: string) => string
  abrirTudo: string
  fecharTudo: string
  /** Os campos de um nó aberto. */
  papel: string
  periodo: string
  stack: string
  endereco: string
  acesso: string
  privado: string
  codigo: string
  licenca: string
  onde: string
  deOnde: string
  idiomas: string
  visitar: string
  codigoAberto: string
  captura: string
  capaDe: (obra: string, autoria: string) => string
  fotograma: string
  notaFicheiros: string
  /** Os campos de uma leitura. */
  autor: string
  rubricaLbl: string
  publicado: string
  duracaoLbl: string
  ficheiroLbl: string
  original: string
  ouvir: string
  ver: string
  dimensoes: string
  notaVoz: (leituras: number, videos: number) => string
}

const ROTULOS: Record<Idioma, Rotulos> = {
  pt: {
    projetos: 'projetos/', voz: 'voz/', percurso: 'percurso/', mandatos: 'mandatos/', formacao: 'certificados/',
    contacto: 'contacto/', privacidade: 'privacidade/', ficheiros: 'ficheiros/', colofao: 'colofão/',
    entradas: (n) => `${n} ${n === 1 ? 'entrada' : 'entradas'}`,
    contaProjetos: 'projetos', contaLeituras: 'gravações', contaCargos: 'cargos', contaMandatos: 'mandatos',
    nascido: (ano) => `nascido em ${ano}`,
    abrirTudo: 'abrir tudo', fecharTudo: 'fechar tudo',
    papel: 'papel', periodo: 'período', stack: 'stack', endereco: 'endereço', acesso: 'acesso',
    privado: 'privado, atrás de autenticação', codigo: 'código', licenca: 'licença',
    onde: 'onde', deOnde: 'de onde', idiomas: 'idiomas',
    visitar: 'visitar', codigoAberto: 'código aberto', captura: 'Captura de ecrã de',
    capaDe: (obra, autoria) => `Capa de «${obra}», de ${autoria}`, fotograma: 'Imagem de',
    notaFicheiros: 'Todos os tamanhos acima são lidos do ficheiro real no build. Nada aqui é escrito à mão.',
    autor: 'autoria', rubricaLbl: 'rubrica', publicado: 'publicado', duracaoLbl: 'duração',
    ficheiroLbl: 'ficheiro', original: 'no editor', ouvir: 'Ouvir', ver: 'Ver', dimensoes: 'imagem',
    notaVoz: (n, v) =>
      `As ${n} leituras são os ficheiros originais, byte a byte, do que o esquerda.net publicou — vivem aqui porque o feed do podcast só guarda os episódios mais recentes, e estas caíram fora dele. Os ${v} vídeos vieram da página do Transborda e foram recodificados uma vez, para tocarem em todos os browsers. A voz é minha; os textos e as peças são de quem os fez, e cada entrada liga à origem.`,
  },
  en: {
    projetos: 'projects/', voz: 'voice/', percurso: 'career/', mandatos: 'mandates/', formacao: 'certificates/',
    contacto: 'contact/', privacidade: 'privacy/', ficheiros: 'files/', colofao: 'colophon/',
    entradas: (n) => `${n} ${n === 1 ? 'entry' : 'entries'}`,
    contaProjetos: 'projects', contaLeituras: 'recordings', contaCargos: 'positions', contaMandatos: 'mandates',
    nascido: (ano) => `born ${ano}`,
    abrirTudo: 'expand all', fecharTudo: 'collapse all',
    papel: 'role', periodo: 'period', stack: 'stack', endereco: 'address', acesso: 'access',
    privado: 'private, behind authentication', codigo: 'source', licenca: 'licence',
    onde: 'where', deOnde: 'from', idiomas: 'languages',
    visitar: 'visit', codigoAberto: 'open source', captura: 'Screenshot of',
    capaDe: (obra, autoria) => `Cover of “${obra}”, by ${autoria}`, fotograma: 'Still from',
    notaFicheiros: 'Every size above is read from the real file at build time. Nothing here is typed by hand.',
    autor: 'author', rubricaLbl: 'series', publicado: 'published', duracaoLbl: 'length',
    ficheiroLbl: 'file', original: 'at the publisher', ouvir: 'Listen to', ver: 'Watch', dimensoes: 'picture',
    notaVoz: (n, v) =>
      `The ${n} readings are the original files, byte for byte, of what esquerda.net published — they live here because the podcast feed keeps only the most recent episodes, and these dropped out of it. The ${v} films came from the Transborda page and were re-encoded once, so they play in every browser. The voice is mine; the texts and the pieces belong to those who made them, and every entry links to its source.`,
  },
  fr: {
    projetos: 'projets/', voz: 'voix/', percurso: 'parcours/', mandatos: 'mandats/', formacao: 'certificats/',
    contacto: 'contact/', privacidade: 'confidentialite/', ficheiros: 'fichiers/', colofao: 'colophon/',
    entradas: (n) => `${n} ${n === 1 ? 'entrée' : 'entrées'}`,
    contaProjetos: 'projets', contaLeituras: 'enregistrements', contaCargos: 'postes', contaMandatos: 'mandats',
    nascido: (ano) => `né en ${ano}`,
    abrirTudo: 'tout ouvrir', fecharTudo: 'tout fermer',
    papel: 'rôle', periodo: 'période', stack: 'stack', endereco: 'adresse', acesso: 'accès',
    privado: 'privé, derrière une authentification', codigo: 'code', licenca: 'licence',
    onde: 'où', deOnde: 'd’où', idiomas: 'langues',
    visitar: 'visiter', codigoAberto: 'code ouvert', captura: 'Capture d’écran de',
    capaDe: (obra, autoria) => `Couverture de « ${obra} », de ${autoria}`, fotograma: 'Image de',
    notaFicheiros: 'Toutes les tailles ci-dessus sont lues sur le fichier réel au build. Rien ici n’est saisi à la main.',
    autor: 'auteur', rubricaLbl: 'rubrique', publicado: 'publié', duracaoLbl: 'durée',
    ficheiroLbl: 'fichier', original: 'chez l’éditeur', ouvir: 'Écouter', ver: 'Regarder', dimensoes: 'image',
    notaVoz: (n, v) =>
      `Les ${n} lectures sont les fichiers originaux, octet par octet, de ce qu’esquerda.net a publié — ils vivent ici parce que le flux du podcast ne garde que les épisodes les plus récents, et ceux-ci en sont sortis. Les ${v} vidéos viennent de la page de Transborda et ont été réencodées une fois, pour être lues par tous les navigateurs. La voix est la mienne ; les textes et les pièces sont de ceux qui les ont faits, et chaque entrée renvoie à sa source.`,
  },
  es: {
    projetos: 'proyectos/', voz: 'voz/', percurso: 'trayectoria/', mandatos: 'mandatos/', formacao: 'certificados/',
    contacto: 'contacto/', privacidade: 'privacidad/', ficheiros: 'archivos/', colofao: 'colofón/',
    entradas: (n) => `${n} ${n === 1 ? 'entrada' : 'entradas'}`,
    contaProjetos: 'proyectos', contaLeituras: 'grabaciones', contaCargos: 'cargos', contaMandatos: 'mandatos',
    nascido: (ano) => `nacido en ${ano}`,
    abrirTudo: 'abrir todo', fecharTudo: 'cerrar todo',
    papel: 'papel', periodo: 'período', stack: 'stack', endereco: 'dirección', acesso: 'acceso',
    privado: 'privado, tras autenticación', codigo: 'código', licenca: 'licencia',
    onde: 'dónde', deOnde: 'de dónde', idiomas: 'idiomas',
    visitar: 'visitar', codigoAberto: 'código abierto', captura: 'Captura de pantalla de',
    capaDe: (obra, autoria) => `Portada de «${obra}», de ${autoria}`, fotograma: 'Imagen de',
    notaFicheiros: 'Todos los tamaños de arriba se leen del fichero real en el build. Nada aquí se escribe a mano.',
    autor: 'autoría', rubricaLbl: 'sección', publicado: 'publicado', duracaoLbl: 'duración',
    ficheiroLbl: 'fichero', original: 'en el editor', ouvir: 'Escuchar', ver: 'Ver', dimensoes: 'imagen',
    notaVoz: (n, v) =>
      `Las ${n} lecturas son los ficheros originales, byte a byte, de lo que esquerda.net publicó — viven aquí porque el feed del podcast solo guarda los episodios más recientes, y estas quedaron fuera. Los ${v} vídeos vinieron de la página de Transborda y se recodificaron una vez, para reproducirse en todos los navegadores. La voz es mía; los textos y las piezas son de quienes los hicieron, y cada entrada enlaza a su origen.`,
  },
}
const rot = ROTULOS[idioma]

const totais = [
  `${projetos.length} ${rot.contaProjetos}`,
  `${leituras.length} ${rot.contaLeituras}`,
  `${posicoes.length} ${rot.contaCargos}`,
  `${mandatos.length} ${rot.contaMandatos}`,
  // A entrada mais antiga da lista era de 2007, e «desde 2007» a seguir a três
  // contagens lia-se como data de nascimento — que é precisamente o que agora
  // está lá, e por ser mesmo isso: 1986, o único número desta página que o
  // build não consegue derivar de nada. Vive em `contacto.nascimento`.
  rot.nascido(contacto.nascimento),
]

/**
 * Os dois CV, na ficha de contacto. São dois e não um em todas as línguas: a
 * página existe em quatro, os documentos em duas, e quem lê a página em
 * francês tem de poder escolher em qual das duas leva o percurso. Cada um
 * rotulado pelo nome do ficheiro, que já diz a língua.
 */
/**
 * O total do nó `voz/`. Sai da soma das durações medidas em disco, e não de
 * uma linha escrita à mão: acrescentar uma leitura é acrescentar um ficheiro
 * e uma entrada, e o total acerta-se sozinho.
 */
const totalVoz = leituras.reduce((s, l) => s + (medidasVoz[l.id]?.segundos ?? 0), 0)

const cvs = ficheiros.filter((f) => f.id === 'cv-pt' || f.id === 'cv-en')
---

<div class="totais">
  <p>{totais.join(' · ')}</p>
  <p class="totais__controlos" data-controlos hidden>
    <button type="button" data-abrir-tudo>{rot.abrirTudo}</button>
    <span aria-hidden="true">·</span>
    <button type="button" data-fechar-tudo>{rot.fecharTudo}</button>
  </p>
</div>

<ul class="arvore" role="list" data-arvore>
  <Node
    id="projetos"
    nivel={2}
    nome={rot.projetos}
    aberto={true}
    colunas={[{ classe: 'nota', valor: rot.entradas(projetos.length) }]}
  >
    <ul class="arvore arvore--filha" role="list">
      {
        projetos.map((p) => (
          <Node
            id={p.id}
            nivel={3}
            nome={p.dominio}
            colunas={[
              { classe: 'papel', valor: t(p.papel, idioma) },
              ...(p.periodo ? [{ classe: 'periodo' as const, valor: periodo(p.periodo) }] : []),
              { classe: 'estado', valor: estado(p.estado, idioma), dataEstado: p.estado },
            ]}
          >
            <Fragment slot="resumo">
              {/* A captura fechada, e não a descrição.
                  O que se via sem clicar era uma linha de texto, e a imagem
                  ficava atrás de um clique que a maior parte de quem passa não
                  dá. Trocou-se: a captura é o que a listagem mostra de véspera,
                  e a descrição passa a viver dentro do nó aberto, com o resto.
                  Quem não tem captura — os dois de baixo — continua a mostrar a
                  descrição, que é melhor do que uma linha vazia. */}
              {p.shot !== null ? (
                <span class="shot shot--resumo">
                  <img
                    src={`/shots/${p.shot}`}
                    alt={`${rot.captura} ${p.dominio}: ${t(p.linha, idioma)}`}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ) : (
                <span class="linha__desc">{t(p.linha, idioma)}</span>
              )}
            </Fragment>
            {/* As ligações viviam dentro do `<summary>`, que já é um controlo:
                dois controlos aninhados são um `nested-interactive` do axe, e um
                leitor de ecrã absorve-os no nome do resumo em vez de os expor.
                Aqui dentro são links normais, e com área de toque a sério. */}
            {((p.url !== null && p.url !== CANONICO) || p.codigo !== null) && (
              <p class="linha__ligacoes">
                {p.url !== null && p.url !== CANONICO && (
                  <a href={p.url} rel="noopener">{rot.visitar} ↗</a>
                )}
                {p.codigo !== null && (
                  <a href={p.codigo} rel="noopener">{rot.codigoAberto} ↗</a>
                )}
              </p>
            )}
            <div class="no__texto">
              {p.shot !== null && <p>{t(p.linha, idioma)}</p>}
              {p.detalhe.map((d) => <p>{t(d, idioma)}</p>)}
            </div>
            <dl class="no__campos">
              <dt>{rot.papel}</dt>
              <dd>{t(p.papel, idioma)}</dd>
              {p.periodo && (
                <>
                  <dt>{rot.periodo}</dt>
                  <dd>{periodoLongo(p.periodo, idioma)}</dd>
                </>
              )}
              {p.stack.length > 0 && (
                <>
                  <dt>{rot.stack}</dt>
                  <dd>{p.stack.join(' · ')}</dd>
                </>
              )}
              {p.codigo !== null && (
                <>
                  <dt>{rot.codigo}</dt>
                  <dd>
                    <a href={p.codigo} rel="noopener">{p.codigo.replace('https://', '')}</a>
                  </dd>
                </>
              )}
              {p.url !== null && p.url !== CANONICO && (
                <>
                  <dt>{rot.endereco}</dt>
                  <dd>
                    <a href={p.url} rel="noopener">{p.dominio}</a>
                  </dd>
                </>
              )}
              {p.estado === 'privado' && (
                <>
                  <dt>{rot.acesso}</dt>
                  <dd>{rot.privado}</dd>
                </>
              )}
            </dl>
          </Node>
        ))
      }
    </ul>
  </Node>

  {
    leituras.length > 0 && (
      <Node
        id="voz"
        nivel={2}
        nome={rot.voz}
        colunas={[
          { classe: 'nota', valor: rot.entradas(leituras.length) },
          { classe: 'tam', valor: duracaoLonga(totalVoz) },
        ]}
      >
        <ul class="arvore arvore--filha" role="list">
          {leituras.map((l) => (
            <Node
              id={l.id}
              nivel={3}
              nome={l.titulo}
              colunas={[
                { classe: 'papel', valor: l.autoria },
                { classe: 'periodo', valor: l.data.slice(0, 4) },
                { classe: 'tam', valor: duracao(medidasVoz[l.id].segundos) },
              ]}
            >
              <Fragment slot="resumo">
                {/* A imagem, e não a fonte — a mesma troca que se fez em
                    projetos/. Onze linhas com um parágrafo por baixo eram uma
                    parede de texto onde não se via o que ali estava.

                    A capa da edição onde há uma, o fotograma onde é vídeo, e
                    nada onde não há imagem nenhuma: a linha já traz autoria,
                    ano e duração, e uma frase repetida ali só a estica.

                    Um `<audio controls>` aqui dentro seria o que parecia
                    óbvio, e não pode ser: dentro de um `<summary>` é um
                    controlo dentro de um controlo — o `nested-interactive` do
                    axe — e um leitor de ecrã engole-o no nome do resumo. O
                    leitor fica no corpo, a um clique de distância. */}
                {l.capa !== null ? (
                  <span class="capa capa--resumo">
                    <img
                      src={`/capas/${l.capa.ficheiro}`}
                      alt={rot.capaDe(l.capa.obra, l.autoria)}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                ) : l.formato === 'video' ? (
                  <span class="capa capa--resumo">
                    {/* Sem `width`/`height`: os únicos números à mão seriam os
                        do vídeo, e a capa não tem as dimensões do vídeo — é
                        exportada a 960×540 venha ele de onde vier. Como o CSS
                        fixa a altura, o que falta declarar é a largura, e essa
                        não desloca nada por baixo. */}
                    <img
                      src={`/voz/${l.id}.webp`}
                      alt={`${rot.fotograma} ${l.titulo}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                ) : null}
              </Fragment>
              {/* Leitor nativo, áudio ou vídeo: sem uma linha de JavaScript, e
                  com preload="none" não faz pedido nenhum enquanto ninguém
                  carregar em tocar. O vídeo leva capa — sem ela, um `<video>`
                  que não pré-carrega é um retângulo preto na listagem. */}
              {l.formato === 'video' ? (
                <video
                  class="leitor leitor--video"
                  controls
                  preload="none"
                  playsinline
                  src={`/voz/${l.id}.mp4`}
                  poster={`/voz/${l.id}.webp`}
                  width={medidasVoz[l.id].largura}
                  height={medidasVoz[l.id].altura}
                  aria-label={`${rot.ver} ${l.titulo} — ${l.autoria}`}
                />
              ) : (
                <audio
                  class="leitor"
                  controls
                  preload="none"
                  src={`/voz/${l.id}.mp3`}
                  aria-label={`${rot.ouvir} ${l.titulo} — ${l.autoria}`}
                />
              )}
              <div class="no__texto">
                <p>{t(l.fonte, idioma)}</p>
              </div>
              <dl class="no__campos">
                <dt>{rot.autor}</dt>
                <dd>{l.autoria}</dd>
                <dt>{rot.papel}</dt>
                <dd>{t(l.papel, idioma)}</dd>
                <dt>{rot.rubricaLbl}</dt>
                <dd>{l.rubrica ? `${l.rubrica} · ${l.editor}` : l.editor}</dd>
                <dt>{rot.publicado}</dt>
                <dd>{dataCurta(l.data, idioma)}</dd>
                <dt>{rot.duracaoLbl}</dt>
                <dd>{duracao(medidasVoz[l.id].segundos)}</dd>
                {l.formato === 'video' && (
                  <>
                    <dt>{rot.dimensoes}</dt>
                    <dd>{`${medidasVoz[l.id].largura}×${medidasVoz[l.id].altura}`}</dd>
                  </>
                )}
                <dt>{rot.ficheiroLbl}</dt>
                <dd>
                  <a href={`/voz/${l.id}.${l.formato === 'video' ? 'mp4' : 'mp3'}`} download>
                    {`${l.id}.${l.formato === 'video' ? 'mp4' : 'mp3'}`}
                  </a>
                  {` · ${tamanho(medidasVoz[l.id].bytes)}`}
                </dd>
                <dt>{rot.original}</dt>
                <dd>
                  <a href={l.origem} rel="noopener">{l.origem.replace(/^https:\/\/(www\.)?/, '')}</a>
                </dd>
              </dl>
            </Node>
          ))}
        </ul>
        <p class="no__texto no__texto--nota">{rot.notaVoz(leituras.filter((l) => l.formato === 'audio').length, leituras.filter((l) => l.formato === 'video').length)}</p>
      </Node>
    )
  }

  {
    posicoes.length > 0 && (
      <Node
        id="percurso"
        nivel={2}
        nome={rot.percurso}
        colunas={[{ classe: 'nota', valor: rot.entradas(posicoes.length) }]}
      >
        <ul class="arvore arvore--filha" role="list">
          {posicoes.map((p) => (
            <Node
              id={p.id}
              nivel={3}
              nome={`${t(p.cargo, idioma)} · ${p.organizacao}`}
              colunas={[{ classe: 'periodo', valor: periodo(p.periodo) }]}
            >
              <Fragment slot="resumo">
                {/* A marca sobe para o resumo pela mesma razão que a captura
                    dos projetos: quem passa os olhos pela listagem reconhece um
                    logótipo antes de ler um cargo. O que fica atrás do clique é
                    o texto, que é o que ninguém lê de passagem.

                    Um `<img>` é conteúdo de frase, portanto vive dentro do
                    `<summary>` sem o invalidar — ao contrário de um `<figure>`,
                    que foi o que obrigou a envolver a captura num `<span>`. */}
                {p.logo && (
                  <span class="marca-org marca-org--resumo">
                    <img
                      class="marca-org__base"
                      src={`/logos/${p.logo}`}
                      alt={p.organizacao}
                      loading="lazy"
                      decoding="async"
                    />
                    {/* A camada a cores por cima, onde existe. Sai do mesmo
                        original e com a mesma caixa, portanto assenta ao pixel;
                        e como não leva o `invert`, mantém a cor nos dois temas.
                        Sem `alt`, porque quem nomeia a casa é a camada de baixo
                        e repetir o nome dava-o duas vezes a um leitor de ecrã. */}
                    {p.logoCor && (
                      <img
                        class="marca-org__cor"
                        src={`/logos/${p.logoCor}`}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </span>
                )}
              </Fragment>
              <div class="no__texto">
                {p.linhas.map((l) => <p>{t(l, idioma)}</p>)}
              </div>
            </Node>
          ))}
        </ul>
      </Node>
    )
  }

  {
    mandatos.length > 0 && (
      <Node
        id="mandatos"
        nivel={2}
        nome={rot.mandatos}
        colunas={[{ classe: 'nota', valor: rot.entradas(mandatos.length) }]}
      >
        <ul class="arvore arvore--filha" role="list">
          {mandatos.map((m) => (
            <Node
              id={m.id}
              nivel={3}
              nome={`${t(m.cargo, idioma)} · ${m.organizacao}`}
              colunas={[{ classe: 'periodo', valor: periodo(m.periodo) }]}
              folha={m.linhas.length === 0}
            >
              <div class="no__texto">
                {m.linhas.map((l) => <p>{t(l, idioma)}</p>)}
              </div>
            </Node>
          ))}
        </ul>
      </Node>
    )
  }

  {
    formacao.length > 0 && (
      <Node
        id="formacao"
        nivel={2}
        nome={rot.formacao}
        colunas={[{ classe: 'nota', valor: rot.entradas(formacao.length) }]}
      >
        <ul class="arvore arvore--filha" role="list">
          {formacao.map((f) => (
            <Node
              id={f.id}
              nome={t(f.curso, idioma)}
              colunas={[
                { classe: 'papel', valor: f.instituicao },
                { classe: 'periodo', valor: periodo(f.periodo) },
              ]}
              folha
            />
          ))}
        </ul>
        <p class="no__texto no__texto--nota">
          {t(notaCertificados, idioma)}
        </p>
      </Node>
    )
  }

  <Node id="contacto" nivel={2} nome={rot.contacto} aberto={true}>
    <p class="no__texto no__texto--nota">{t(contacto.nota, idioma)}</p>
    <dl class="no__campos">
      {contacto.email && (
        <>
          <dt>email</dt>
          <dd><a href={`mailto:${contacto.email}`}>{contacto.email}</a></dd>
        </>
      )}
      {contacto.linkedin && (
        <>
          <dt>linkedin</dt>
          <dd><a href={contacto.linkedin} rel="noopener">{contacto.linkedin.replace(/^https:\/\//, '')}</a></dd>
        </>
      )}
      <dt>{rot.onde}</dt>
      <dd>{t(contacto.concelho, idioma)}</dd>
      <dt>{rot.deOnde}</dt>
      <dd>{t(contacto.naturalidade, idioma)}</dd>
      <dt>cv</dt>
      <dd>
        {cvs.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={c.href}>{c.nome}</a>
          </>
        ))}
      </dd>
      {contacto.idiomas.length > 0 && (
        <>
          <dt>{rot.idiomas}</dt>
          <dd>
            {contacto.idiomas.map((i) => `${t(i.lingua, idioma)} (${t(i.nivel, idioma)})`).join(' · ')}
          </dd>
        </>
      )}
    </dl>
  </Node>

  {/* A seguir ao contacto de propósito: o campo «responsável» remete para o
      endereço que está no nó de cima, e um leitor que salte para aqui a partir
      do rodapé encontra os dois juntos. */}
  <Node id="privacidade" nivel={2} nome={rot.privacidade}>
    <p class="no__texto no__texto--nota">{t(notaPrivacidade, idioma)}</p>
    <dl class="no__campos">
      {privacidade.map((c) => (
        <>
          <dt>{t(c.rotulo, idioma)}</dt>
          <dd>{t(c.texto, idioma)}</dd>
        </>
      ))}
    </dl>
  </Node>

  <Node
    id="ficheiros"
    nivel={2}
    nome={rot.ficheiros}
    colunas={[{ classe: 'nota', valor: rot.entradas(ficheiros.length) }]}
  >
    <ul class="arvore arvore--filha" role="list">
      {
        ficheiros.map((f) => (
          <Node
            id={f.id}
            nome={f.nome}
            href={f.href}
            colunas={[{ classe: 'tam', valor: tamanho(f.bytes) }]}
          >
            <Fragment slot="resumo">
              <span class="linha__desc">{t(f.descricao, idioma)}</span>
            </Fragment>
          </Node>
        ))
      }
    </ul>
    <p class="no__texto no__texto--nota">{rot.notaFicheiros}</p>
  </Node>

  <Node id="colofao" nivel={2} nome={rot.colofao}>
    <div class="no__texto">
      {colofaoSite.map((l) => <p>{t(l, idioma)}</p>)}
    </div>
    <dl class="no__campos">
      <dt>{rot.codigo}</dt>
      <dd><a href={codigoDoSite} rel="noopener">{codigoDoSite.replace('https://', '')}</a></dd>
      <dt>{rot.licenca}</dt>
      <dd><a href={licenca.url} rel="noopener">{licenca.nome}</a></dd>
    </dl>
  </Node>
</ul>

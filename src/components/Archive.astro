---
import Node from './Node.astro'
import { projetos, posicoes, mandatos, formacao, contacto, ficheiros, CANONICO } from '../data'
import { colofao, codigoDoSite } from '../data/textos.ts'
import type { Idioma } from '../data'
import { t, periodo, periodoLongo, tamanho, estado } from '../data/formato'

interface Props { idioma: Idioma }
const { idioma } = Astro.props
const en = idioma === 'en'


const rot = en
  ? { projetos: 'projects/', percurso: 'career/', mandatos: 'mandates/', formacao: 'certificates/', contacto: 'contact/', ficheiros: 'files/', colofao: 'colophon/',
      entradas: (n: number) => `${n} ${n === 1 ? 'entry' : 'entries'}`,
      papel: 'role', periodo: 'period', stack: 'stack', endereco: 'address', acesso: 'access',
      privado: 'private, behind authentication', abrir: 'Open' }
  : { projetos: 'projetos/', percurso: 'percurso/', mandatos: 'mandatos/', formacao: 'certificados/', contacto: 'contacto/', ficheiros: 'ficheiros/', colofao: 'colofao/',
      entradas: (n: number) => `${n} ${n === 1 ? 'entrada' : 'entradas'}`,
      papel: 'papel', periodo: 'período', stack: 'stack', endereco: 'endereço', acesso: 'acesso',
      privado: 'privado, atrás de autenticação', abrir: 'Abrir' }
const anoInicio = Math.min(
  ...[...posicoes, ...mandatos, ...projetos.filter((p) => p.periodo)].map((x) =>
    parseInt((x.periodo as { inicio: string }).inicio.slice(0, 4), 10)
  )
)
const totais = [
  `${projetos.length} ${en ? 'products' : 'produtos'}`,
  `${posicoes.length} ${en ? 'positions' : 'posições'}`,
  `${mandatos.length} ${en ? 'mandates' : 'mandatos'}`,
  en ? `since ${anoInicio}` : `desde ${anoInicio}`,
]
---

<p class="totais">{totais.join(' · ')}</p>

<ul class="arvore" role="list" data-arvore>
  <Node
    id="projetos"
    nome={rot.projetos}
    aberto={true}
    colunas={[{ classe: 'nota', valor: rot.entradas(projetos.length) }]}
  >
    <ul class="arvore arvore--filha" role="list">
      {
        projetos.map((p) => (
          <Node
            id={p.id}
            nome={p.dominio}
            colunas={[
              { classe: 'papel', valor: t(p.papel, idioma) },
              ...(p.periodo ? [{ classe: 'periodo' as const, valor: periodo(p.periodo) }] : []),
              { classe: 'estado', valor: estado(p.estado, idioma), dataEstado: p.estado },
            ]}
          >
            <Fragment slot="resumo">
              <span class="linha__desc">{t(p.linha, idioma)}</span>
              {((p.url !== null && p.url !== CANONICO) || p.codigo !== null) && (
                <span class="linha__ligacoes">
                  {p.url !== null && p.url !== CANONICO && (
                    <a href={p.url} rel="noopener">{en ? 'visit' : 'visitar'} ↗</a>
                  )}
                  {p.codigo !== null && (
                    <a href={p.codigo} rel="noopener">{en ? 'open source' : 'código aberto'} ↗</a>
                  )}
                </span>
              )}
            </Fragment>
            <div class="no__texto">
              {p.detalhe.map((d) => <p>{t(d, idioma)}</p>)}
            </div>
            <dl class="no__campos">
              <dt>{rot.papel}</dt>
              <dd>{t(p.papel, idioma)}</dd>
              {p.periodo && (
                <>
                  <dt>{rot.periodo}</dt>
                  <dd>{periodoLongo(p.periodo, idioma)}</dd>
                </>
              )}
              {p.stack.length > 0 && (
                <>
                  <dt>{rot.stack}</dt>
                  <dd>{p.stack.join(' · ')}</dd>
                </>
              )}
              {p.codigo !== null && (
                <>
                  <dt>{en ? 'source' : 'código'}</dt>
                  <dd>
                    <a href={p.codigo} rel="noopener">{p.codigo.replace('https://', '')}</a>
                  </dd>
                </>
              )}
              {p.url !== null && p.url !== CANONICO && (
                <>
                  <dt>{rot.endereco}</dt>
                  <dd>
                    <a href={p.url} rel="noopener">{p.dominio}</a>
                  </dd>
                </>
              )}
              {p.estado === 'privado' && (
                <>
                  <dt>{rot.acesso}</dt>
                  <dd>{rot.privado}</dd>
                </>
              )}
            </dl>
            {p.shot !== null && (
              <figure class="shot">
                {p.url !== null && p.url !== CANONICO ? (
                  <a href={p.url} rel="noopener" tabindex="-1" aria-hidden="true">
                    <img src={`/shots/${p.shot}`} alt="" loading="lazy" decoding="async" />
                  </a>
                ) : (
                  <img src={`/shots/${p.shot}`} alt="" loading="lazy" decoding="async" />
                )}
              </figure>
            )}
          </Node>
        ))
      }
    </ul>
  </Node>

  {
    posicoes.length > 0 && (
      <Node
        id="percurso"
        nome={rot.percurso}
        colunas={[{ classe: 'nota', valor: rot.entradas(posicoes.length) }]}
      >
        <ul class="arvore arvore--filha" role="list">
          {posicoes.map((p) => (
            <Node
              id={p.id}
              nome={`${t(p.cargo, idioma)} · ${p.organizacao}`}
              colunas={[{ classe: 'periodo', valor: periodo(p.periodo) }]}
            >
              <div class="no__texto">
                {p.linhas.map((l) => <p>{t(l, idioma)}</p>)}
              </div>
            </Node>
          ))}
        </ul>
      </Node>
    )
  }

  {
    mandatos.length > 0 && (
      <Node
        id="mandatos"
        nome={rot.mandatos}
        colunas={[{ classe: 'nota', valor: rot.entradas(mandatos.length) }]}
      >
        <ul class="arvore arvore--filha" role="list">
          {mandatos.map((m) => (
            <Node
              id={m.id}
              nome={`${t(m.cargo, idioma)} · ${m.organizacao}`}
              colunas={[{ classe: 'periodo', valor: periodo(m.periodo) }]}
              folha={m.linhas.length === 0}
            >
              <div class="no__texto">
                {m.linhas.map((l) => <p>{t(l, idioma)}</p>)}
              </div>
            </Node>
          ))}
        </ul>
      </Node>
    )
  }

  {
    formacao.length > 0 && (
      <Node
        id="formacao"
        nome={rot.formacao}
        colunas={[{ classe: 'nota', valor: rot.entradas(formacao.length) }]}
      >
        <ul class="arvore arvore--filha" role="list">
          {formacao.map((f) => (
            <Node
              id={f.id}
              nome={t(f.curso, idioma)}
              colunas={[
                { classe: 'papel', valor: f.instituicao },
                { classe: 'periodo', valor: periodo(f.periodo) },
              ]}
              folha
            />
          ))}
        </ul>
        <p class="no__texto no__texto--nota">
          {en
            ? 'Online courses, taken independently. Not degrees from these institutions.'
            : 'Cursos online, feitos por conta própria. Não são graus destas instituições.'}
        </p>
      </Node>
    )
  }

  <Node id="contacto" nome={rot.contacto} aberto={true}>
    <p class="no__texto no__texto--nota">{t(contacto.nota, idioma)}</p>
    <dl class="no__campos">
      {contacto.email && (
        <>
          <dt>email</dt>
          <dd><a href={`mailto:${contacto.email}`}>{contacto.email}</a></dd>
        </>
      )}
      {contacto.linkedin && (
        <>
          <dt>linkedin</dt>
          <dd><a href={contacto.linkedin} rel="noopener">{contacto.linkedin.replace(/^https:\/\//, '')}</a></dd>
        </>
      )}
      <dt>{en ? 'where' : 'onde'}</dt>
      <dd>{t(contacto.concelho, idioma)}</dd>
      <dt>{en ? 'from' : 'de onde'}</dt>
      <dd>{t(contacto.naturalidade, idioma)}</dd>
      <dt>cv</dt>
      <dd>
        <a href="/docs/Fabio-Salgado-CV-PT.pdf">Fabio-Salgado-CV-PT.pdf</a>
      </dd>
      {contacto.idiomas.length > 0 && (
        <>
          <dt>{en ? 'languages' : 'idiomas'}</dt>
          <dd>
            {contacto.idiomas.map((i) => `${t(i.lingua, idioma)} (${t(i.nivel, idioma)})`).join(' · ')}
          </dd>
        </>
      )}
    </dl>
  </Node>

  <Node
    id="ficheiros"
    nome={rot.ficheiros}
    colunas={[{ classe: 'nota', valor: rot.entradas(ficheiros.length) }]}
  >
    <ul class="arvore arvore--filha" role="list">
      {
        ficheiros.map((f) => (
          <Node
            id={f.id}
            nome={f.nome}
            href={f.href}
            colunas={[{ classe: 'tam', valor: tamanho(f.bytes) }]}
          />
        ))
      }
    </ul>
    <p class="no__texto no__texto--nota">
      {en
        ? 'Every size above is read from the real file at build time. Nothing here is typed by hand.'
        : 'Todos os tamanhos acima são lidos do ficheiro real no build. Nada aqui é escrito à mão.'}
    </p>
  </Node>

  <Node id="colofao" nome={rot.colofao}>
    <div class="no__texto">
      {colofao.map((l) => <p>{t(l, idioma)}</p>)}
    </div>
    <dl class="no__campos">
      <dt>{en ? 'source' : 'código'}</dt>
      <dd><a href={codigoDoSite} rel="noopener">{codigoDoSite.replace('https://', '')}</a></dd>
    </dl>
  </Node>
</ul>

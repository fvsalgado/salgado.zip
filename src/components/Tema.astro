---
/**
 * Alternador de tema. Nasce escondido: sem JS não faz nada, e um controlo que
 * não faz nada é pior do que controlo nenhum.
 */
import type { Idioma } from '../data'

interface Props { idioma: Idioma }
const { idioma } = Astro.props

const ROTULOS: Record<Idioma, string> = {
  pt: 'Alternar tema',
  en: 'Toggle theme',
  fr: 'Changer de thème',
  es: 'Cambiar de tema',
}
const rot = ROTULOS[idioma]
---

{/* O glifo leva `aria-hidden` pela mesma razão que as setas das ligações que
    saem: quem nomeia o botão é o `aria-label`, e um símbolo decorativo que
    também se nomeasse punha o axe a assinalar que o nome não contém o que se
    vê. É o mesmo tratamento em toda a casa, e agora sem exceção. */}
<button type="button" class="tema" data-controlos data-tema aria-label={rot} title={rot} hidden>
  <span aria-hidden="true">◐</span>
</button>

---
/**
 * Alternador de tema. Nasce escondido: sem JS não faz nada, e um controlo que
 * não faz nada é pior do que controlo nenhum.
 */
import type { Idioma } from '../data'

interface Props { idioma: Idioma }
const { idioma } = Astro.props

const ROTULOS: Record<Idioma, string> = {
  pt: 'Alternar tema',
  en: 'Toggle theme',
  fr: 'Changer de thème',
  es: 'Cambiar de tema',
}
const rot = ROTULOS[idioma]
---

<button type="button" class="tema" data-controlos data-tema aria-label={rot} title={rot} hidden>◐</button>

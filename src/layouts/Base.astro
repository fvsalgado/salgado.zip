---
import '../styles/base.css'
import '../styles/print.css'
import { cabecalho, contacto, projetos, leituras, posicoes, datas, medidasVoz, CANONICO, IDIOMAS, LINGUAS, PADRAO } from '../data'
import type { Idioma } from '../data'
import { t, duracaoISO } from '../data/formato'
import { perfilGithub } from '../data/textos.ts'
import dimensoes from '../generated/og.json' with { type: 'json' }

interface Props {
  idioma: Idioma
  titulo: string
  descricao: string
  caminho: string
  classe?: string
  robots?: string
  /**
   * A mesma página nas quatro línguas. Quando presente, emite hreflang — e as
   * quatro chaves são obrigatórias, porque um hreflang que aponta a três
   * línguas de quatro é pior do que hreflang nenhum: diz ao motor de busca que
   * a quarta não existe.
   */
  alternos?: Record<Idioma, string>
}

const { idioma, titulo, descricao, caminho, classe = '', robots, alternos } = Astro.props
const canonical = CANONICO + caminho

const maiuscula = (frase: string) => frase[0]!.toUpperCase() + frase.slice(1)

const og = dimensoes as { largura?: number; altura?: number }
const lang = LINGUAS[idioma].html
const modificado = Object.values(datas).sort().at(-1)

/** A frase do salto para o conteúdo. Primeira coisa que um leitor de ecrã lê. */
const SALTAR: Record<Idioma, string> = {
  pt: 'Saltar para o conteúdo',
  en: 'Skip to content',
  fr: 'Aller au contenu',
  es: 'Saltar al contenido',
}

/** Perfis e sítios noutros domínios. O próprio não entra: já é o `url`. */
/**
 * `sameAs` é «estes URL são a mesma entidade que eu», e não «isto é meu».
 *
 * Até aqui levava os endereços dos projetos, que são obras e não perfis — e
 * já estão no grafo como `CreativeWork` com `creator` a apontar aqui. Dizer a
 * um motor de busca que sou o fado.today não me identifica: dilui-me. Ficam os
 * dois perfis que são mesmo eu, e o do GitHub sai do endereço do repositório
 * para não haver duas cadeias a dizer o mesmo.
 */
const sameAs = [
  ...(contacto.linkedin ? [contacto.linkedin] : []),
  perfilGithub,
]

/** O cargo atual é o da posição sem fim: derivado, não escrito. */
const atual = posicoes.find((p) => p.periodo.fim === null)

/** A Vercel serve o script; fora dela o caminho não existe. */
const analytics = Boolean(process.env.VERCEL)

const PESSOA = `${CANONICO}/#pessoa`
const SITE = `${CANONICO}/#site`

/**
 * Um grafo, não um nó solto: quem lê à máquina — motor de busca, assistente,
 * agregador — encontra a pessoa, o site, a página e o que foi feito, ligados
 * por identificador. Os projetos privados entram sem endereço, como em todo o
 * lado. Nada aqui é escrito à mão que não venha de src/data.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': PESSOA,
      name: cabecalho.nome,
      jobTitle: t(cabecalho.cargo, idioma),
      description: `${maiuscula(t(cabecalho.areas, idioma))}. ${t(cabecalho.linhas[0]!, idioma)}`,
      url: CANONICO,
      image: `${CANONICO}/fabio-salgado.jpg`,
      address: { '@type': 'PostalAddress', addressRegion: contacto.regiao, addressCountry: 'PT' },
      // Há vários Fábio Salgado indexados. Um ano de nascimento com um lugar ao
      // lado é o que diz a um motor de busca qual deles é este. O lugar sai do
      // primeiro dos `lugares`, que estão por ordem biográfica — não é escrito
      // uma segunda vez só para caber aqui.
      birthDate: contacto.nascimento,
      ...(contacto.lugares[0]
        ? {
            birthPlace: {
              '@type': 'Place',
              name: contacto.lugares[0].nome,
              address: { '@type': 'PostalAddress', addressLocality: contacto.lugares[0].nome, addressCountry: 'PT' },
            },
          }
        : {}),
      knowsLanguage: contacto.idiomas.map((i) => ({ '@type': 'Language', name: t(i.lingua, idioma) })),
      hasOccupation: { '@type': 'Occupation', name: t(cabecalho.cargo, idioma) },
      ...(atual
        ? {
            worksFor: {
              '@type': 'Organization',
              name: atual.organizacao,
              ...(atual.organizacaoUrl ? { url: atual.organizacaoUrl } : {}),
            },
          }
        : {}),
      ...(contacto.email ? { email: `mailto:${contacto.email}` } : {}),
      ...(sameAs.length ? { sameAs } : {}),
    },
    ...projetos.map((p) => ({
      '@type': 'CreativeWork',
      name: p.dominio,
      description: t(p.linha, idioma),
      creator: { '@id': PESSOA },
      inLanguage: 'pt-PT',
      ...(p.url ? { url: p.url } : {}),
      ...(p.codigo ? { codeRepository: p.codigo } : {}),
    })),
    /**
     * As gravações, e não como obra minha.
     *
     * Os projetos acima saem com `creator: PESSOA`, que é o que são. Estas não:
     * o `author` é de quem escreveu o texto e eu entro como `contributor`, que
     * é o que a voz é. Um `AudioObject` com o meu nome no `author` dizia a uma
     * máquina que o «Torto Arado» é meu.
     *
     * O tipo, a extensão e o editor saem de cada entrada e não de constantes do
     * módulo. Enquanto isto foi tudo `AudioObject` com `RUBRICA` fixa, os dois
     * vídeos do Transborda saíam daqui como mp3 que não existem — dois 404
     * declarados a um motor de busca — e com o esquerda.net como editor de uma
     * peça que não é dele. É o mesmo erro que a página teve, e que se corrigiu
     * lá quando a rubrica passou a viver na entrada.
     */
    ...leituras.map((l) => {
      const video = l.formato === 'video'
      return {
        '@type': video ? 'VideoObject' : 'AudioObject',
        name: l.titulo,
        description: t(l.fonte, idioma),
        author: { '@type': 'Person', name: l.autoria },
        contributor: { '@id': PESSOA },
        publisher: { '@type': 'Organization', name: l.editor },
        ...(l.rubrica ? { isPartOf: { '@type': 'PodcastSeries', name: l.rubrica } } : {}),
        datePublished: l.data,
        inLanguage: 'pt-PT',
        contentUrl: `${CANONICO}/voz/${l.id}.${video ? 'mp4' : 'mp3'}`,
        encodingFormat: video ? 'video/mp4' : 'audio/mpeg',
        ...(medidasVoz[l.id] ? { duration: duracaoISO(medidasVoz[l.id].segundos) } : {}),
        /* A imagem que a entrada mostra: o fotograma do vídeo, ou a capa da
           edição de onde saiu o texto. Um `VideoObject` sem `thumbnailUrl` não
           é elegível para resultado com imagem. */
        ...(video
          ? { thumbnailUrl: `${CANONICO}/voz/${l.id}.webp` }
          : l.capa
            ? { image: `${CANONICO}/capas/${l.capa.ficheiro}` }
            : {}),
        ...(video && medidasVoz[l.id]?.largura
          ? { width: medidasVoz[l.id].largura, height: medidasVoz[l.id].altura }
          : {}),
        isBasedOn: l.origem,
      }
    }),
    {
      '@type': 'WebSite',
      '@id': SITE,
      url: CANONICO,
      name: 'salgado.zip',
      inLanguage: lang,
      publisher: { '@id': PESSOA },
    },
    {
      '@type': 'ProfilePage',
      '@id': canonical,
      url: canonical,
      name: titulo,
      description: descricao,
      inLanguage: lang,
      isPartOf: { '@id': SITE },
      mainEntity: { '@id': PESSOA },
      primaryImageOfPage: { '@type': 'ImageObject', url: `${CANONICO}/og.png` },
      ...(modificado ? { dateModified: modificado } : {}),
    },
  ],
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="author" content={cabecalho.nome} />
    <!-- Sem isto, a Google mostra as capturas dos projetos como miniatura em vez
         de imagem grande, nos resultados e no Discover. -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    {
      alternos && (
        <>
          {IDIOMAS.map((i) => (
            <link rel="alternate" hreflang={LINGUAS[i].html} href={CANONICO + alternos[i]} />
          ))}
          <link rel="alternate" hreflang="x-default" href={CANONICO + alternos[PADRAO]} />
        </>
      )
    }

    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14130f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="salgado.zip" />
    <meta property="og:image" content={CANONICO + '/og.png'} />
    <meta property="og:image:alt" content={`${cabecalho.nome} — ${t(cabecalho.areas, idioma)}`} />
    {og.largura && <meta property="og:image:width" content={String(og.largura)} />}
    {og.altura && <meta property="og:image:height" content={String(og.altura)} />}
    <meta property="og:locale" content={LINGUAS[idioma].og} />
    {
      IDIOMAS.filter((i) => i !== idioma).map((i) => (
        <meta property="og:locale:alternate" content={LINGUAS[i].og} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />

    <!-- O SVG é a fonte e é o que os browsers modernos escolhem: inverte-se
         sozinho no tema escuro. Os dois de baixo existem para quem não o lê —
         o .ico para agregadores e leitores antigos, o de 180px para quem
         guarda o site no ecrã inicial. Todos saem do mesmo desenho. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/json" href="/resume.json" title="JSON Resume" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-mono-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-serif-latin-400-normal.woff2"
      crossorigin
    />

    <script is:inline src="/tema.js"></script>
    {
      /**
       * Medição de visitas. Só sai no build da Vercel, e é de propósito: fora
       * de lá o caminho não existe, e a verificação 2 — todas as ligações
       * internas devolvem 200 — falharia num ficheiro que o preview local não
       * tem para servir.
       *
       * O script e o ponto de recolha vivem no próprio domínio, o que é a razão
       * de ser este e não outro: a CSP continua `script-src 'self'`, e a
       * verificação 8 continua a ver zero pedidos a terceiros porque não há
       * nenhum. Sem cookies, sem localStorage: a visita é identificada por um
       * resumo do pedido, descartado ao fim de 24 horas.
       *
       * São 2 495 bytes que o orçamento de 10 kB não conta, porque não passam
       * pelo dist/. Ficam escritos aqui para não serem um custo escondido.
       */
      analytics && <script is:inline defer src="/_vercel/insights/script.js" />
    }
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={classe}>
    <a class="salta" href="#conteudo">{SALTAR[idioma]}</a>
    <slot />
  </body>
</html>
